# ============================================================
# NEXUS-TAF · Backend — variables de entorno
# Copia este archivo como ".env" y ajusta los valores.
# NUNCA subas el archivo ".env" real a un repositorio.
# ============================================================

# Entorno: development | production
NODE_ENV=development

# Puerto donde escucha la API
PORT=4000

# --- PostgreSQL (datos relacionales: usuarios, roles, credenciales, finanzas) ---
# Formato: postgresql://usuario:password@host:puerto/basededatos
POSTGRES_URL=postgresql://nexus:nexus_pass@localhost:5432/nexus_taf

# --- MongoDB (datos documentales: proyectos, sprints, tareas, documentos, auditoría) ---
MONGO_URL=mongodb://localhost:27017/nexus_taf

# --- Autenticación ---
# Genera un valor largo y aleatorio en producción, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_este_valor_por_uno_largo_y_aleatorio
JWT_EXPIRES_IN=8h
JWT_PREAUTH_EXPIRES_IN=5m

# Nombre del emisor que verán las apps de autenticación (Google Authenticator, etc.)
TOTP_ISSUER=NEXUS-TAF

# --- CORS ---
# Orígenes del frontend permitidos, separados por coma
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# --- Almacenamiento de documentos ---
# Carpeta local donde se guardan los archivos cargados por el portal del cliente.
# En producción, reemplaza esta lógica por un bucket S3 / DigitalOcean Spaces
# (ver src/utils/storage.js para el punto de extensión).
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# --- Seguridad de sesión ---
MAX_LOGIN_ATTEMPTS=5
